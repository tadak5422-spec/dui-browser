# =============================================================
# Dui Browser - minimal v1 profile (arm64)
# Base: kiwibrowser/src (classic) .build/production_build_reference/args.gn
# V1: URL bar + search + back/reload. Baaki extras band. Baad me step-by-step add karenge.
# =============================================================

target_os = "android"
target_cpu = "arm64"

is_debug = false
is_java_debug = false

android_channel = "stable"                 # GN assertion: default/canary/dev/beta/stable hi allowed hain
is_official_build = true
is_component_build = false
is_chrome_branded = false
is_clang = true

# Chhota binary: symbols aur unwind tables hataye
symbol_level = 0
exclude_unwind_tables = true

use_unofficial_version_number = false
android_default_version_code = "1"          # workflow badalta hai
android_keystore_name = "dev"
android_keystore_password = "public_password"
android_keystore_path = "../../keystore.jks"
android_default_version_name = "Git"        # workflow badalta hai

# Experiments / field trials OFF (random A-B feature popups nahi)
fieldtrial_testing_like_official_build = false

icu_use_data_file = false
enable_iterator_debugging = false

# Google API keys placeholders (sign-in hatane ke baad bhi build chalna chahiye)
google_api_key = "KIWIBROWSER"
google_default_client_id = "42.apps.kiwibrowser.com"
google_default_client_secret = "KIWIBROWSER_NOT_SO_SECRET"
use_official_google_api_keys = false

# -------------------------------------------------------------
# Features jo RAKHE hain
# -------------------------------------------------------------
ffmpeg_branding = "Chrome"                  # MP3/AAC/H.264 rakho (sites kaam karein)
proprietary_codecs = true

enable_extensions = false                   # V1 me extensions nahi; baad me on kar sakte hain
enable_pdf = false                          # PDF viewer hataya (first-run se bhi nahi)
enable_plugins = false
enable_nacl = false

# -------------------------------------------------------------
# Features jo HATAYE hain
# -------------------------------------------------------------
enable_widevine = false                     # DRM hataya (Netflix etc. nahi chalenge)
enable_mse_mpeg2ts_stream_parser = false
enable_remoting = false
rtc_use_h264 = false
v8_use_external_startup_data = false        # alag .pak dependency nahi

update_android_aar_prebuilts = true

# Translate / sign-in promos / feed / cast / autofill popups band
disable_features = "Translate,TranslateUI,Translate2024,TranslateLanguagePicker,MediaRouter,CastMediaRouteDialog,MediaRouterDialog,OptimizationHints,InterestFeedContentSuggestions,InterestFeedV2,SigninPromo,SigninInterceptBubble,SigninIntercept,AutofillServerCommunication,AutofillProfileEnabled,AutofillCreditCardEnabled,AutofillAddressEnabled,PasswordManagerOnboardingAndroid,ContextualSearch,ContextualSearchBox,RelatedSearchSuggestions,ChromeWhatsNewUI,PrivacySandboxSettings4,PrivacySandboxAdsAPIs,QuietPromoTabGroups,TabGroupsContinuationService,IncognitoReauthenticationAndroid"

disable_android_lint = true
treat_warnings_as_errors = false

# Fast incremental builds
cc_wrapper = "ccache"
